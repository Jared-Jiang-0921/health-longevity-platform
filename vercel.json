{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "healthlongevity.cn"
        }
      ],
      "destination": "https://www.healthlongevity.cn/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Content-Type", "value": "image/x-icon" },
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        { "key": "Content-Type", "value": "image/svg+xml" },
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/spa-shell.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/en/spa-shell.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/account",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/account/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/payment",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/payment/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/favorites",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/favorites/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/health-skills",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/health-skills/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/health-questionnaire",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/health-questionnaire/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/forgot-password/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/reset-password",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/reset-password/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/ops",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/ops/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/org",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/org/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/tax",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/tax/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/solutions/risk",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/solutions/risk/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/solutions/aging",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/solutions/aging/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/tcm-prevention/constitution",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/tcm-prevention/constitution/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/products/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/en/account",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/account/(.*)",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/payment",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/payment/(.*)",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/favorites",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/favorites/(.*)",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/health-skills",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/health-skills/(.*)",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/health-questionnaire",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/health-questionnaire/(.*)",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/forgot-password",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/forgot-password/(.*)",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/reset-password",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/reset-password/(.*)",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/ops",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/ops/(.*)",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/org",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/org/(.*)",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/tax",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/tax/(.*)",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/solutions/risk",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/solutions/risk/(.*)",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/solutions/aging",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/solutions/aging/(.*)",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/tcm-prevention/constitution",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/tcm-prevention/constitution/(.*)",
      "destination": "/en/spa-shell.html"
    },
    {
      "source": "/en/products/(.*)",
      "destination": "/en/spa-shell.html"
    }
  ]
}
