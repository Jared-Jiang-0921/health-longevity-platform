# 长寿健康平台 — Nginx 站点示例
#
# 这是仓库里的模板，不是 ECS 上正在生效的配置。
# 线上 443 是机器上的一份拷贝。只提交本文件、或执行 deploy-ecs.sh 里的 nginx reload，
# 都不会把下面的 301 / 404 规则写进那份正在监听的配置。
#
# 生效步骤（在 ECS 上人工做，先备份正在使用的站点文件，不要备份或传出 .env）：
#   sudo cp /etc/nginx/conf.d/healthlongevity.conf /etc/nginx/conf.d/healthlongevity.conf.bak-YYYYmmddHHMM
#   把正在 listen 443 的 server 按本文件拆开：裸域名单独 301，www 使用下面的 location。
#   sudo nginx -t && sudo systemctl reload nginx
# 回滚：
#   sudo cp /etc/nginx/conf.d/healthlongevity.conf.bak-YYYYmmddHHMM /etc/nginx/conf.d/healthlongevity.conf
#   sudo nginx -t && sudo systemctl reload nginx
# 若站点文件不在 conf.d，以 `nginx -T` 里实际 include 的文件为准。不要把证书私钥或环境变量写进备份说明。
#
# 端口约定：
#   3000 — 主站 api-server（/api/*）
#   3001 — AI 健康咨询模块（仅 /api/ai/*，需 SSE 关缓冲）
#   3002 — consult-mcp

# 裸域名整站跳到 www，路径和查询串原样保留（$request_uri）。
server {
    listen 80;
    listen [::]:80;
    server_name healthlongevity.cn;
    return 301 https://www.healthlongevity.cn$request_uri;
}

# ---------- www。有证书时把 listen 改成 443 ssl http2，并加上证书与 HSTS。----------
server {
    listen 80;
    listen [::]:80;
    server_name www.healthlongevity.cn;

    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    root /opt/health-longevity-platform/dist;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Permissions-Policy "geolocation=(), microphone=(self), camera=()" always;

    error_page 404 /404.html;

    location = /404.html {
        internal;
        charset utf-8;
        default_type text/html;
    }

    # 首页短缓存。location 里写了 add_header 之后，server 级安全头不会继承，所以这里重复。
    location = / {
        try_files /index.html =404;
        add_header Cache-Control "public, max-age=600" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Permissions-Policy "geolocation=(), microphone=(self), camera=()" always;
    }

    location = /index.html {
        try_files /index.html =404;
        add_header Cache-Control "public, max-age=600" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Permissions-Policy "geolocation=(), microphone=(self), camera=()" always;
    }

    location = /en {
        try_files /en/index.html =404;
        add_header Cache-Control "public, max-age=600" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Permissions-Policy "geolocation=(), microphone=(self), camera=()" always;
    }

    location = /en/index.html {
        try_files /en/index.html =404;
        add_header Cache-Control "public, max-age=600" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Permissions-Policy "geolocation=(), microphone=(self), camera=()" always;
    }

    location ~* \.mjs$ {
        default_type application/javascript;
    }

    location ~* \.html$ {
        charset utf-8;
        default_type text/html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    }

    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ^~ /images/ {
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    # 根目录图标用精确匹配，和 /images/ 一样按文件提供，不回退到 HTML。
    # 精确匹配先于按扩展名的正则，避免只放行 /images/ 时 /favicon.ico 返回 403。
    location = /favicon.ico {
        default_type image/x-icon;
        try_files /favicon.ico =404;
        add_header Cache-Control "public, max-age=604800" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /favicon.png {
        default_type image/png;
        try_files /favicon.png =404;
        add_header Cache-Control "public, max-age=604800" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /favicon.svg {
        default_type image/svg+xml;
        try_files /favicon.svg =404;
        add_header Cache-Control "public, max-age=604800" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /apple-touch-icon.png {
        default_type image/png;
        try_files /apple-touch-icon.png =404;
        add_header Cache-Control "public, max-age=604800" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /robots.txt {
        default_type text/plain;
        add_header Cache-Control "public, max-age=3600" always;
    }

    location = /sitemap.xml {
        default_type application/xml;
        charset utf-8;
        add_header Cache-Control "public, max-age=3600" always;
    }

    location = /llms.txt {
        default_type text/plain;
        charset utf-8;
        add_header Cache-Control "public, max-age=3600" always;
    }

    location = /longevity-news/feed.xml {
        default_type application/atom+xml;
        charset utf-8;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # 未预渲染的动态路径回退到这个壳，而不是首页。壳本身 noindex，且没有首页 canonical。
    location = /spa-shell.html {
        internal;
        charset utf-8;
        default_type text/html;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "no-store" always;
    }

    location = /en/spa-shell.html {
        internal;
        charset utf-8;
        default_type text/html;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "no-store" always;
    }

    # 阿拉伯语版已移除，旧链接永久跳到中文同一路径
    location = /ar {
        return 301 /;
    }

    location ^~ /ar/ {
        rewrite ^/ar/(.*)$ /$1 permanent;
    }

    # 动态或登录后路径才回退到 noindex 的前端壳，不回退到首页。
    # 已有预渲染文件时 try_files 会先用文件。名单与 src/lib/sitePaths.js 一致。
    # 未知资讯 id 不在这里，没有文件就 404。/products/… 没有预渲染文件时也不是首页。
    location ~ ^/en/(account|payment|favorites|health-skills|health-questionnaire|forgot-password|reset-password|ops|org|tax)(/.*)?$ {
        try_files $uri $uri/index.html /en/spa-shell.html;
    }

    location ~ ^/(account|payment|favorites|health-skills|health-questionnaire|forgot-password|reset-password|ops|org|tax)(/.*)?$ {
        try_files $uri $uri/index.html /spa-shell.html;
    }

    # /products/evidence/nmn 与 /products/evidence/omega-3（及对应 /en/ 路径）
    # 若已预渲染为 $uri/index.html，下面的 try_files 会先给出该文件，
    # 响应不经过 spa-shell，因此不带 X-Robots-Tag noindex，也不带 Cache-Control no-store。
    # 这与其它公开预渲染文章一样：location 本身不另加缓存头。
    # 线上 443 若把 /products/ 无条件指到 spa-shell.html、没有先查 $uri/index.html，
    # 才需要在机器上为这些精确路径加例外。本仓库不改正在监听的配置。
    location ~ ^/en/products/.+ {
        try_files $uri $uri/index.html /en/spa-shell.html;
    }

    location ~ ^/products/.+ {
        try_files $uri $uri/index.html /spa-shell.html;
    }

    location ~ ^/en/solutions/(risk|aging)(/.*)?$ {
        try_files $uri $uri/index.html /en/spa-shell.html;
    }

    location ~ ^/solutions/(risk|aging)(/.*)?$ {
        try_files $uri $uri/index.html /spa-shell.html;
    }

    location ~ ^/en/tcm-prevention/constitution(/.*)?$ {
        try_files $uri $uri/index.html /en/spa-shell.html;
    }

    location ~ ^/tcm-prevention/constitution(/.*)?$ {
        try_files $uri $uri/index.html /spa-shell.html;
    }

    location / {
        try_files $uri $uri/index.html =404;
    }

    # consult-mcp：Grok 连接器。^~ 避免被上面的正则抢走。
    location = /.well-known/oauth-protected-resource {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /.well-known/oauth-protected-resource/mcp {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /.well-known/oauth-authorization-server {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /mcp {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # AI 咨询 SSE：必须写在通用 /api/ 之前（更长前缀优先）
    # client_max_body_size 不能按登录账号区分。白名单账号的图片、PDF、Word、TXT
    # 在应用层不再按张数和单文件大小拒绝，但请求体仍受这里的 25m 约束。
    # 前端 CONSULT_TRANSPORT_MAX_BYTES 与此对齐。不要只改其中一边。
    # 不把 25m 调到与 /api/ 相同的 120m：那会让所有 /api/ai/ 调用方都能提交更大请求体。
    location ^~ /api/ai/ {
        client_max_body_size 25m;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        gzip off;
    }

    location ^~ /api/ {
        client_max_body_size 120m;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 443 裸域名（证书路径按机器上 certbot 的实际输出填写，不要把私钥内容写进仓库）：
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name healthlongevity.cn;
#     ssl_certificate     /etc/letsencrypt/live/healthlongevity.cn/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/healthlongevity.cn/privkey.pem;
#     return 301 https://www.healthlongevity.cn$request_uri;
# }
# www 的 443 使用与上面 www 相同的 location，不要再把未知的 /en/ 或 / 回退到首页。
