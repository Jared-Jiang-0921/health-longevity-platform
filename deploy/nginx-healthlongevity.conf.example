# 长寿健康平台 — Nginx 站点示例
#
# 这是仓库里的模板，不是 ECS 上正在生效的配置。
# 线上 443 是机器上的一份拷贝。只提交本文件、或执行 deploy-ecs.sh 里的 nginx reload，
# 都不会把下面的 301 / 404 规则写进那份正在监听的配置。
#
# 生效步骤（在 ECS 上人工做，先备份正在使用的站点文件，不要备份或传出 .env）：
#   sudo cp /etc/nginx/conf.d/healthlongevity.conf /etc/nginx/conf.d/healthlongevity.conf.bak-YYYYmmddHHMM
#   把正在 listen 443 的 server 按本文件拆开：裸域名单独 301，www 使用下面的 location。
#   sudo nginx -t && sudo systemctl reload nginx
# 回滚：
#   sudo cp /etc/nginx/conf.d/healthlongevity.conf.bak-YYYYmmddHHMM /etc/nginx/conf.d/healthlongevity.conf
#   sudo nginx -t && sudo systemctl reload nginx
# 若站点文件不在 conf.d，以 `nginx -T` 里实际 include 的文件为准。不要把证书私钥或环境变量写进备份说明。
#
# 端口约定：
#   3000 — 主站 api-server（/api/*）
#   3001 — AI 健康咨询模块（仅 /api/ai/*，需 SSE 关缓冲）
#   3002 — consult-mcp

# 裸域名整站跳到 www，路径和查询串原样保留（$request_uri）。
server {
    listen 80;
    listen [::]:80;
    server_name healthlongevity.cn;
    return 301 https://www.healthlongevity.cn$request_uri;
}

# ---------- www。有证书时把 listen 改成 443 ssl http2，并加上证书与 HSTS。----------
server {
    listen 80;
    listen [::]:80;
    server_name www.healthlongevity.cn;

    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    root /opt/health-longevity-platform/dist;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Permissions-Policy "geolocation=(), microphone=(self), camera=()" always;

    error_page 404 /404.html;

    location = /404.html {
        internal;
        charset utf-8;
        default_type text/html;
    }

    location = / {
        try_files /index.html =404;
    }

    location ~* \.mjs$ {
        default_type application/javascript;
    }

    location ~* \.html$ {
        charset utf-8;
        default_type text/html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    }

    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ^~ /images/ {
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    location = /robots.txt {
        default_type text/plain;
        add_header Cache-Control "public, max-age=3600" always;
    }

    location = /sitemap.xml {
        default_type application/xml;
        charset utf-8;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # 动态或登录后路径才回退到对应语言的前端壳。已有预渲染文件时 try_files 会先用文件。
    # 名单与 src/lib/sitePaths.js 的 SPA_EXACT 一致。未知资讯 id 不在这里，没有文件就 404。
    location ~ ^/(en|ar)/(account|payment|favorites|health-skills|health-questionnaire|forgot-password|reset-password|ops|org|tax)(/.*)?$ {
        try_files $uri $uri/index.html /$1/index.html;
    }

    location ~ ^/(account|payment|favorites|health-skills|health-questionnaire|forgot-password|reset-password|ops|org|tax)(/.*)?$ {
        try_files $uri $uri/index.html /index.html;
    }

    location ~ ^/(en|ar)/products/.+ {
        try_files $uri $uri/index.html /$1/index.html;
    }

    location ~ ^/products/.+ {
        try_files $uri $uri/index.html /index.html;
    }

    location ~ ^/(en|ar)/solutions/(risk|aging)(/.*)?$ {
        try_files $uri $uri/index.html /$1/index.html;
    }

    location ~ ^/solutions/(risk|aging)(/.*)?$ {
        try_files $uri $uri/index.html /index.html;
    }

    location ~ ^/(en|ar)/tcm-prevention/constitution(/.*)?$ {
        try_files $uri $uri/index.html /$1/index.html;
    }

    location ~ ^/tcm-prevention/constitution(/.*)?$ {
        try_files $uri $uri/index.html /index.html;
    }

    location / {
        try_files $uri $uri/index.html =404;
    }

    # consult-mcp：Grok 连接器。^~ 避免被上面的正则抢走。
    location = /.well-known/oauth-protected-resource {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /.well-known/oauth-protected-resource/mcp {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /.well-known/oauth-authorization-server {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /mcp {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # AI 咨询 SSE：必须写在通用 /api/ 之前（更长前缀优先）
    location ^~ /api/ai/ {
        client_max_body_size 25m;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        gzip off;
    }

    location ^~ /api/ {
        client_max_body_size 120m;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 443 裸域名（证书路径按机器上 certbot 的实际输出填写，不要把私钥内容写进仓库）：
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name healthlongevity.cn;
#     ssl_certificate     /etc/letsencrypt/live/healthlongevity.cn/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/healthlongevity.cn/privkey.pem;
#     return 301 https://www.healthlongevity.cn$request_uri;
# }
# www 的 443 使用与上面 www 相同的 location，不要再把未知的 /en/、/ar/ 或 / 回退到首页。
